# Copy to .env and set these to your local PostgreSQL/pgAdmin connection values.
POSTGRES_DB=BDCRM
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
CONTACT_SYNC_API_TOKEN=replace-with-the-same-shared-token-in-all-three-projects
CONTACT_SYNC_TENANT_COMPANY_ID=1
