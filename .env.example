# Copy to .env and set these to your local PostgreSQL/pgAdmin connection values.
POSTGRES_DB=BDCRM
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
CONTACT_SYNC_API_TOKEN=replace-with-the-same-shared-token-in-all-three-projects
CONTACT_SYNC_TENANT_COMPANY_ID=1
# The public URL at which users open BDCRM. It must exactly match the callback
# registered for the BDCRM OAuth client in NexusOne.
NEXUS_SSO_TOKEN_URL=http://host.docker.internal:8005/api/sso/token/
NEXUS_SSO_CLIENT_ID=set-the-bdcrm-client-id-from-nexusone
NEXUS_SSO_CLIENT_SECRET=set-the-bdcrm-client-secret-from-nexusone
NEXUS_SSO_REDIRECT_URI=http://your-bdcrm-host:8003
# Comma-separated list of every callback URI registered for this client.
NEXUS_SSO_REDIRECT_URIS=http://your-primary-bdcrm-host:8003,http://your-secondary-bdcrm-host:8003,https://your-tailnet-host:6004/
